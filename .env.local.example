# Local environment variables for running the PHP dev server against production DB
# Copy to `.env.local` and fill in values (DO NOT COMMIT `.env.local`).

# Recommended: use an SSH tunnel and connect locally.
# Example tunnel:
#   ssh -N -L 3307:127.0.0.1:3306 YOUR_SSH_USER@YOUR_PROD_HOST
SSH_TARGET=root@72.62.169.128
LOCAL_DB_TUNNEL_PORT=3307

STAMPS_DB_HOST=127.0.0.1
STAMPS_DB_PORT=3307

# Production database
STAMPS_DB_NAME=YOUR_DB_NAME
STAMPS_DB_USER=YOUR_DB_USER
STAMPS_DB_PASS=YOUR_DB_PASSWORD

# Optional
STAMPS_DB_TABLE=stamps
